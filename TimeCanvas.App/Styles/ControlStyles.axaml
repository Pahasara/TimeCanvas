<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Global default: v1 set this at the Window level so it cascaded
       everywhere (buttons, pickers, labels) unless a control overrides it. -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource RussoOne}" />
  </Style>

  <!-- Day-strip button -->
  <Style Selector="Button.dayButton">
    <Setter Property="Background" Value="{DynamicResource BgControl}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Width" Value="52" />
    <Setter Property="Height" Value="56" />
    <Setter Property="Margin" Value="3,0" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.dayButton:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderFocus}" />
  </Style>
  <Style Selector="Button.dayButton.selected">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
  </Style>
  <Style Selector="Button.dayButton.selected TextBlock">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Task row card -->
  <Style Selector="Border.taskRow">
    <Setter Property="Background" Value="{DynamicResource BgPanel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.taskRow:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderFocus}" />
  </Style>
  <Style Selector="Border.taskRow.completed">
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <!-- Small circular icon button (delete, etc.) -->
  <Style Selector="Button.iconButton">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>
  <Style Selector="Button.iconButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource Danger}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Primary action button (Add Task, etc.) -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16,8" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource BgControl}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,8" />
  </Style>

  <!-- Progress bar -->
  <Style Selector="ProgressBar.completion">
    <Setter Property="Height" Value="10" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="{DynamicResource BgControl}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>

  <!-- TimePicker — v1's exact three-property approach, just never applied to v2 -->
  <Style Selector="TimePicker">
    <Setter Property="Background" Value="{DynamicResource BgInput}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- NumericUpDown — styled to match TimePicker; didn't exist in v1 -->
  <Style Selector="NumericUpDown">
    <Setter Property="Background" Value="{DynamicResource BgInput}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  
  <!-- Task description text box: restores v1's RussoOne identity, weight
       reset to Normal since the Window-level Bold default reads too heavy
       for a full sentence of body text. VerticalContentAlignment is the
       fix for the top-aligned-text issue. -->
  <Style Selector="TextBox.taskDescription">
    <Setter Property="FontFamily" Value="{DynamicResource RussoOne}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!-- Completion checkbox -->
  <Style Selector="CheckBox.taskDone">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="4,0" />
  </Style>
  
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource BgInput}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

</Styles>
